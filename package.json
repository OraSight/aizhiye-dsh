{
  "name": "dsh-azy-entry",
  "version": "0.2.0",
  "private": true,
  "description": "在 DeepSeek Harness 左侧加入「爱职业」入口：用爱职业账号登录，把该账号的算力密钥与模型接到本地 Harness",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/yaml-edit.test.mjs test/compute-endpoints.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.2-rc.1+": "compatible"
      }
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "爱职业",
    "summary": "左侧工具条加入「爱职业」入口。用爱职业账号登录，读取该账号名下的算力密钥，自动在本地 Harness 里配好指向 ohhub.net/v1 的模型，配置完即可直接选用。",
    "categories": [
      "入口",
      "模型"
    ],
    "surfaces": [
      "web"
    ],
    "permissions": {
      "network": [
        "https://azy.ohhub.net",
        "https://ohhub.net"
      ]
    }
  }
}
